# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_impact

# SEC EDGAR fair-access User-Agent MUST include a contact email.
SEC_USER_AGENT=MarketImpact/0.1 (your-email@example.com)

# Optional LLM (used only after original source text is retrieved)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Protect /api/cron/ingest
CRON_SECRET=change-me

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Optional market data
POLYGON_API_KEY=

# Optional news sources (adapters stay disabled without keys/feeds)
BENZINGA_API_KEY=
BENZINGA_USE_WEBSOCKET=false
GLOBENEWSWIRE_RSS_URL=
BUSINESSWIRE_FEED_URL=
PRNEWSWIRE_FEED_URL=
